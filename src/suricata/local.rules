# 1. Metasploit / Meterpreter C2 JA4 TLS Fingerprint Detection
# Plaintext Client Hello TLS fingerprinting extracts cipher suites and extensions in fixed order
alert tls $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"ALPINE DETECT - Meterpreter C2 TLS JA4 Fingerprint Detected"; \
    ja4.hash; content:"t13d1516h2_8daaf6152771_a00000000000"; \
    classtype:trojan-activity; \
    sid:1000001; rev:1; \
)
