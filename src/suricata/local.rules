# ==============================================================================
# Alpine Lab Custom Suricata Signatures
# ==============================================================================

# 1. Metasploit / Meterpreter C2 JA4 TLS Fingerprint Detection
# Plaintext Client Hello TLS fingerprinting extracts cipher suites and extensions in fixed order
alert tls $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"ALPINE DETECT - Meterpreter C2 TLS JA4 Fingerprint Detected"; \
    ja4.hash; content:"t13d1516h2_8daaf6152771_a00000000000"; \
    classtype:trojan-activity; \
    sid:1000001; rev:1; \
)

# 2. Plaintext Credential Transmission Inspection
alert tcp $HOME_NET any -> $HOME_NET [21,23] ( \
    msg:"ALPINE DETECT - Cleartext Protocol Authentication Observed"; \
    flow:to_server,established; \
    content:"USER"; nocase; \
    classtype:bad-unknown; \
    sid:1000002; rev:1; \
)

# 3. High-Volume / Anomalous DNS Query Length (Tunneling / DGA Recon)
alert dns $HOME_NET any -> any 53 ( \
    msg:"ALPINE DETECT - Suspiciously Long DNS Query (>50 chars)"; \
    dns.query; pcre:"/^.{50,}/"; \
    classtype:bad-unknown; \
    sid:1000003; rev:1; \
)
